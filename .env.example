DB_USER=workshop
# Production: generate with `openssl rand -hex 24` — don't reuse across envs.
DB_PASSWORD=CHANGE_ME
DB_NAME=workshop_db

# Production: generate with `openssl rand -hex 32`.
JWT_SECRET=CHANGE_ME_use_a_long_random_string

# Production: CORS_ORIGIN=https://admin.tallerlallave.com
# The localhost values below are for local dev only.
CORS_ORIGIN=http://localhost:4200,http://localhost

SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_RECEP_PASSWORD=CHANGE_ME
SEED_MECH_PASSWORD=CHANGE_ME

# Grafana admin password (docker-compose.observability.yml).
# Production: generate with `openssl rand -hex 16`.
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME
